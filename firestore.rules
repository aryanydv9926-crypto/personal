rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && exists(/databases/$(db)/documents/admins/$(request.auth.uid)); }
    function myCid() { return get(/databases/$(db)/documents/users/$(request.auth.uid)).data.cid; }
    function mine(c) { return signedIn() && myCid() == c; }

    match /admins/{u}    { allow read: if signedIn() && request.auth.uid == u; }   // admins are created by hand in the console
    match /users/{u}     { allow read: if signedIn() && request.auth.uid == u || isAdmin(); allow write: if isAdmin(); }
    match /customers/{c} { allow read: if isAdmin() || mine(c); allow write: if isAdmin(); }
    match /records/{r}   { allow read: if isAdmin() || mine(resource.data.c); allow write: if isAdmin(); }
    match /bills/{b}     { allow read: if isAdmin() || mine(resource.data.c); allow write: if isAdmin(); }
    match /prices/{p}    { allow read: if signedIn(); allow write: if isAdmin(); }
    match /meta/{m}      { allow read: if m == 'settings' || signedIn(); allow write: if isAdmin(); }
    match /payments/{p}  {
      allow read: if isAdmin() || mine(resource.data.c);
      // a customer may only CREATE a pending payment for themselves; only admin can approve/reject/edit/delete
      allow create: if isAdmin() || (mine(request.resource.data.c) && request.resource.data.st == 'pending'
                       && request.resource.data.amt is number && request.resource.data.amt > 0
                       && !('rs' in request.resource.data)
                       && (!('img' in request.resource.data) || request.resource.data.img.size() < 700000));
      allow update, delete: if isAdmin();
    }
  }
}
